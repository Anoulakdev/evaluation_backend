// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int         @id @default(autoincrement())
  username     String      @unique
  password     String
  status       String      @default("A") @db.VarChar(50)
  roleId       Int
  role         Role        @relation(fields: [roleId], references: [id])
  first_name   String?     @db.VarChar(255)
  last_name    String?     @db.VarChar(255)
  emp_code     String?     @unique @db.VarChar(255)
  gender       String?     @db.VarChar(255)
  tel          String?     @db.VarChar(255)
  email        String?     @db.VarChar(255)
  empimg       String?     @db.VarChar(255)
  rank         Int?
  posId        Int?
  position     Position?   @relation(fields: [posId], references: [id])
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])
  divisionId   Int?
  division     Division?   @relation(fields: [divisionId], references: [id])
  officeId     Int?
  office       Office?     @relation(fields: [officeId], references: [id])
  unitId       Int?
  unit         Unit?       @relation(fields: [unitId], references: [id])
  createdAt    DateTime    @default(now()) @db.Timestamptz(0)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(0)
  givers       Total[]     @relation("Giver")
  receivers    Total[]     @relation("Receiver")

  @@index([departmentId])
  @@index([divisionId])
  @@index([officeId])
  @@index([unitId])
  @@index([posId])
  @@index([roleId])
  @@index([status])
  @@index([status, roleId])
  @@index([divisionId, status])
  @@index([officeId, status])
  @@index([unitId, status])
  @@index([departmentId, status])
}

model Role {
  id     Int     @id @default(autoincrement())
  name   String  @db.VarChar(255)
  users  User[]
  totals Total[]
}

model Department {
  id                Int        @id
  department_name   String?    @db.VarChar(255)
  department_code   String?    @db.VarChar(50)
  department_status String     @default("A") @db.VarChar(50)
  divisions         Division[]
  users             User[]
}

model Division {
  id              Int        @id
  division_name   String?    @db.VarChar(255)
  division_code   String?    @db.VarChar(50)
  division_status String     @default("A") @db.VarChar(50)
  branch_id       Int?
  short_name      String?    @db.VarChar(255)
  insur_code      String?    @db.VarChar(255)
  departmentId    Int
  department      Department @relation(fields: [departmentId], references: [id])
  offices         Office[]
  units           Unit[]
  users           User[]

  @@index([departmentId])
}

model Office {
  id            Int       @id
  office_name   String?   @db.VarChar(255)
  office_code   String?   @db.VarChar(50)
  office_status String    @default("A") @db.VarChar(50)
  divisionId    Int?
  division      Division? @relation(fields: [divisionId], references: [id])
  units         Unit[]
  users         User[]

  @@index([divisionId])
}

model Unit {
  id          Int       @id
  unit_name   String?   @db.VarChar(255)
  unit_code   String?   @db.VarChar(50)
  unit_status String    @default("A") @db.VarChar(50)
  unit_type   String?   @db.VarChar(50)
  divisionId  Int?
  division    Division? @relation(fields: [divisionId], references: [id])
  officeId    Int?
  office      Office?   @relation(fields: [officeId], references: [id])
  users       User[]

  @@index([divisionId])
  @@index([officeId])
}

model PositionGroup {
  id             Int            @id
  pos_group_name String         @db.VarChar(255)
  positioncodes  PositionCode[]
}

model PositionCode {
  id              Int            @id
  pos_code_name   String         @db.VarChar(255)
  pos_code_status String         @default("A") @db.VarChar(50)
  posgroupId      Int?
  positiongroup   PositionGroup? @relation(fields: [posgroupId], references: [id])
  positions       Position[]
}

model Position {
  id           Int           @id
  pos_name     String        @db.VarChar(255)
  pos_status   String        @default("A") @db.VarChar(50)
  poscodeId    Int?
  positioncode PositionCode? @relation(fields: [poscodeId], references: [id])
  users        User[]
}

model Title {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(255)
  subtitles SubTitle[]
}

model SubTitle {
  id      Int    @id @default(autoincrement())
  titleId Int
  title   Title  @relation(fields: [titleId], references: [id])
  name    String @db.VarChar(255)
}

model Score {
  id     Int @id @default(autoincrement())
  sc_num Int
}

model Total {
  id            Int      @id @default(autoincrement())
  roleId        Int
  role          Role     @relation(fields: [roleId], references: [id])
  giverId       Int
  giver         User     @relation("Giver", fields: [giverId], references: [id])
  receiverId    Int
  receiver      User     @relation("Receiver", fields: [receiverId], references: [id])
  together      Boolean  @default(false)
  s1_1          Int      @default(0)
  s1_2          Int      @default(0)
  s1_3          Int      @default(0)
  s1_4          Int      @default(0)
  s1_5          Int      @default(0)
  s1_6          Int      @default(0)
  s1_score      Int      @default(0)
  s2_1          Int      @default(0)
  s2_2          Int      @default(0)
  s2_3          Int      @default(0)
  s2_4          Int      @default(0)
  s2_5          Int      @default(0)
  s2_score      Int      @default(0)
  s3_1          Int      @default(0)
  s3_2          Int      @default(0)
  s3_3          Int      @default(0)
  s3_score      Int      @default(0)
  s4_1          Int      @default(0)
  s4_2          Int      @default(0)
  s4_score      Int      @default(0)
  total_score   Int      @default(0)
  percent_score Float    @default(0)
  approve       Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(0)
  updatedAt     DateTime @updatedAt @db.Timestamptz(0)

  @@unique([giverId, receiverId])
  @@index([giverId])
  @@index([receiverId])
  @@index([receiverId, roleId])
  @@index([receiverId, approve])
}
